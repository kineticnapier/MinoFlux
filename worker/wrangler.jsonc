{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minoflux-remote",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REMOTE",
        "class_name": "RemoteHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RemoteHub"]
    }
  ]
}
